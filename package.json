{
  "name": "@melolab/melopulse",
  "version": "0.1.0",
  "description": "Local coding playlists for MCP agents",
  "keywords": ["mcp", "music", "playlists", "coding", "melolab"],
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "melopulse": "./dist/cli/index.js" },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "docs", "examples", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "node scripts/prepack.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "14.0.3",
    "env-paths": "4.0.0",
    "open": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "20.19.25",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/tover0314-w/melopulse.git" },
  "homepage": "https://github.com/tover0314-w/melopulse#readme",
  "bugs": { "url": "https://github.com/tover0314-w/melopulse/issues" }
}
